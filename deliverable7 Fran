"""
Airbnb vs long-term rental analysis (Christchurch).

Usage (run from the Data201 folder, in the terminal):
    export KOORDINATES_API_KEY="your_key"      # only needed for --lookup

    python deliverable7.py                     # analysis only (fast, safe to re-run)
    python deliverable7.py --merge             # clean new_airbnb.csv and append to airbnbcleaned.csv (run ONCE per new scrape)
    python deliverable7.py --lookup            # (re)do the Koordinates area-code lookup
    python deliverable7.py --merge --lookup    # both, then the analysis

Nothing runs at import time: every step lives in a function and is called from main().
The area-code lookup uses threads instead of multiprocessing, so no worker ever
re-imports this file (that re-import was what re-ran everything and spawned the charts).
"""
import argparse
import os
import time
from concurrent.futures import ThreadPoolExecutor

import matplotlib
import matplotlib.pyplot as plt
import pandas as pd
import requests

# ---------------- CONFIG ----------------
NEW_AIRBNB_CSV = "data/newairbnb.csv"
CLEANED_CSV = "data/airbnbcleaned.csv"
AREA_CODES_CSV = "data/airbnb_with_area_codes.csv"
TENANCY_CSV = "data/QuarterlyTenencyCleaned.csv"
MERGED_OUTPUT_CSV = "data/merged_listings.csv"

API_KEY = os.environ.get("KOORDINATES_API_KEY")  # never hard-code the key
DOMAIN = "koordinates.com"
LAYER_ID = 111227
AREA_CODE_FIELD = "SA22023_V1_00"
RADIUS_M = 100
MAX_RESULTS = 1
N_THREADS = 10  # drop to 5 if you see lots of "Failed for ..." lines
BASE_URL = f"https://{DOMAIN}/services/query/v1/vector.json"
# -----------------------------------------
print(len(pd.read_csv(CLEANED_CSV)))
print(len(pd.read_csv(AREA_CODES_CSV)))
print(len(pd.read_csv(NEW_AIRBNB_CSV)))
print(len(pd.read_csv(MERGED_OUTPUT_CSV)))

# ============ Step 1: clean + merge ============
def clean_airbnb(df):
    # Keep price < 3000: the bulk of listings are below 1500 and we want to drop
    # outliers to see the underlying trend (this loses ~343 listings).
    df = df[df["price"] < 3000]

    # Columns not needed to compare price and number of available properties
    cols_to_drop = [
        "number_of_reviews",
        "last_review",
        "reviews_per_month",
        "calculated_host_listings_count",
        "number_of_reviews_ltm",
        "license",
    ]
    df = df.drop(columns=cols_to_drop)
    df = df[df["neighbourhood_group"] == "Christchurch City"]
    return df.dropna()


# ============ Step 2: area-code lookup ============
def query_point(lat, lon, max_retries=3, verbose=False):
    """Return the area code for one point, or None."""
    params = {
        "key": API_KEY,
        "layer": LAYER_ID,
        "x": lon,
        "y": lat,
        "radius": RADIUS_M,
        "max_results": MAX_RESULTS,
        "geometry": "false",
        "with_field_names": "true",
    }
    for attempt in range(max_retries):
        try:
            resp = requests.get(BASE_URL, params=params, timeout=10)
            resp.raise_for_status()
            data = resp.json()
            if verbose:
                print(data)
            layers = data.get("vectorQuery", {}).get("layers", {})
            features = layers.get(str(LAYER_ID), {}).get("features", [])
            if not features:
                return None
            return features[0]["properties"].get(AREA_CODE_FIELD)
        except requests.exceptions.RequestException as e:
            if attempt == max_retries - 1:
                print(f"Failed for ({lat}, {lon}): {e}")
                return None
            time.sleep(1 + attempt)


def _query_row(row):
    idx, lat, lon = row
    return idx, query_point(lat, lon)


def get_area_codes(input_csv, output_csv=AREA_CODES_CSV):
    if not API_KEY:
        raise SystemExit("Set the KOORDINATES_API_KEY environment variable first.")

    df = pd.read_csv(input_csv)
    rows = list(df[["latitude", "longitude"]].itertuples(name=None))  # (index, lat, lon)
    print(f"Querying {len(rows)} points against layer {LAYER_ID}...")

    results = {}
    with ThreadPoolExecutor(max_workers=N_THREADS) as ex:
        for i, (idx, code) in enumerate(ex.map(_query_row, rows), 1):
            results[idx] = code
            if i % 500 == 0:
                print(f"  {i}/{len(rows)} done")

    df["area_code"] = df.index.map(results)
    df.to_csv(output_csv, index=False)
    print(f"Saved to {output_csv}")

    missing = df["area_code"].isna().sum()
    if missing:
        print(f"Warning: {missing} rows got no match")


# ============ Step 3: analysis ============
def save_bar(x, y, xlabel, ylabel, title, filename):
    fig, ax = plt.subplots(figsize=(14, 6))
    ax.bar(x, y)
    ax.axhline(0, color="black", linewidth=0.8)
    ax.set_xlabel(xlabel)
    ax.set_ylabel(ylabel)
    ax.set_title(title)
    plt.xticks(rotation=90)
    fig.tight_layout()
    fig.savefig(filename, dpi=150)
    plt.close(fig)  # close instead of plt.show() so no windows pile up
    print(f"Saved {filename}")


def run_analysis():
    df = pd.read_csv("data/new_airbnb.csv", low_memory=False)

    listings = pd.read_csv(AREA_CODES_CSV)
    tenancy = pd.read_csv(TENANCY_CSV)

    new_table = pd.merge(
        listings, tenancy, how="left", left_on="area_code", right_on="location_id"
    )
    print(new_table)

    # Median Airbnb price in Christchurch Central (area code 326600)
    chch_central = new_table[new_table["area_code"] == 326600]
    print("Median Airbnb price, chch central:", chch_central["price"].median())
    # -> $253 per night

    # Average difference between Airbnb per night and rental per night
    differences_table = new_table[
        (new_table["dwelling_type"] == "ALL") & (new_table["number_of_beds"] == "ALL")
    ].copy()
    differences_table["difference"] = differences_table["price"] - (
        differences_table["geometric_mean_rent"] / 7
    )
    print(differences_table)

    diff_by_area = (
        differences_table.groupby(["area_code", "neighbourhood"])["difference"]
        .mean()
        .reset_index()
        .sort_values("difference")
    )
    save_bar(
        diff_by_area["area_code"].astype(str),
        diff_by_area["difference"],
        "Area code",
        "Avg difference (Airbnb nightly price - weekly rent/7)",
        "Difference between Airbnb price and daily-equivalent rent, by area",
        "difference_by_area.png",
    )

    max_row = diff_by_area.loc[diff_by_area["difference"].idxmax()]
    print("Largest difference:", max_row["neighbourhood"])
    # -> Papanui, an Airbnb costing ~$522 more per night than a rental

    # Number of Airbnbs (unique names) and total bonds per area
    area_summary = (
        differences_table.groupby(["area_code", "neighbourhood"])
        .agg(
            num_bnbs=("name", "nunique"),
            total_bonds=("total_bonds", "first"),
        )
        .reset_index()
    )

    bnb_vs_rental = area_summary.copy()
    bnb_vs_rental["differences"] = bnb_vs_rental["total_bonds"] - bnb_vs_rental["num_bnbs"]
    bnb_vs_rental = bnb_vs_rental.sort_values("differences")

    neighbourhood_summary = (
        bnb_vs_rental.groupby("neighbourhood")["differences"]
        .mean()
        .reset_index()
        .sort_values("differences")
    )
    save_bar(
        neighbourhood_summary["neighbourhood"],
        neighbourhood_summary["differences"],
        "Neighbourhood (Ward)",
        "Total bonds - number of Airbnb listings",
        "Long-term rentals vs Airbnb listings by ward",
        "bnb_vs_rental_by_ward.png",
    )
    print(bnb_vs_rental)

    new_table.to_csv(MERGED_OUTPUT_CSV, index=False)
    print(f"Saved {MERGED_OUTPUT_CSV}")

    # Christchurch Central has the most Airbnbs relative to rentals and Spreydon the
    # fewest. This makes sense: people visiting for brief trips stay in the city centre.


# ============ Entry point ============
def main():
    matplotlib.use("Agg")  # draw straight to files, never open windows

    parser = argparse.ArgumentParser()
    parser.add_argument("--merge", action="store_true",
                        help="clean new_airbnb.csv and append it to airbnbcleaned.csv")
    parser.add_argument("--lookup", action="store_true",
                        help="redo the Koordinates area-code lookup")
    args = parser.parse_args()

    if args.merge:
        run_merge()
    if args.lookup or not os.path.exists(AREA_CODES_CSV):
        get_area_codes(CLEANED_CSV)
    
    run_analysis()


if __name__ == "__main__":
    main()